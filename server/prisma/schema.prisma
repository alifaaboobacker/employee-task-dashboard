generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DeletionReason {
  RESIGNED
  TERMINATED
  CONTRACT_ENDED
  TRANSFERRED
  DUPLICATE_RECORD
  OTHER
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks  Task[]
  deletionLogs  EmployeeDeletionLog[]

  @@map("admins")
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  employeeCode String   @unique @db.VarChar(20)
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  phone        String?  @db.VarChar(20)
  department   String   @db.VarChar(80)
  designation  String   @db.VarChar(80)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[]

  @@index([name])
  @@index([department])
  @@index([isActive])
  @@map("employees")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(160)
  description String?    @db.VarChar(2000)
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime   @db.Date
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assigneeId String?   @db.Uuid
  assignee   Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid
  createdBy   Admin?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status, assigneeId])
  @@map("tasks")
}

model EmployeeDeletionLog {
  id                  String         @id @default(uuid()) @db.Uuid
  employeeId          String         @db.Uuid
  employeeCode        String         @db.VarChar(20)
  employeeName        String         @db.VarChar(120)
  employeeEmail       String         @db.VarChar(180)
  department          String         @db.VarChar(80)
  reasonCategory      DeletionReason
  reasonDetails       String         @db.VarChar(500)
  unassignedTaskCount Int            @default(0)
  deletedAt           DateTime       @default(now())

  deletedById String? @db.Uuid
  deletedBy   Admin?  @relation(fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("employee_deletion_logs")
}
